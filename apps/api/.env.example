# Copy to .env for local development. Every variable is parsed with zod at boot
# (src/env.ts); the API refuses to start if one is invalid.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# MongoDB connection string. Required. It must point at a replica set because
# order creation uses transactions. `docker compose up -d` starts a single-node
# replica set named rs0.
MONGODB_URI=mongodb://localhost:27017/giftpop?replicaSet=rs0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma separated browser origins allowed to call the API (web and admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# First MongoDB connection: how many attempts, and the first retry delay in ms
# (doubles each attempt, capped at 10 seconds).
DB_CONNECT_MAX_ATTEMPTS=10
DB_CONNECT_BASE_DELAY_MS=250
