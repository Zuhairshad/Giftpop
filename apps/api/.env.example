# Copy to .env for local development. Every variable is parsed with zod at boot
# (src/env.ts); the API refuses to start if one is invalid.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# MongoDB connection string. Required. It must point at a replica set because
# order creation uses transactions. `docker compose up -d` starts a single-node
# replica set named rs0.
MONGODB_URI=mongodb://localhost:27017/giftpop?replicaSet=rs0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma separated browser origins allowed to call the API (web and admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# First MongoDB connection: how many attempts, and the first retry delay in ms
# (doubles each attempt, capped at 10 seconds).
DB_CONNECT_MAX_ATTEMPTS=10
DB_CONNECT_BASE_DELAY_MS=250

# Peppers the hash of staff session tokens. At least 32 random characters.
# Optional in development (a fixed dev value is used); REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the admin app and the store are served from.
ADMIN_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Asset storage. `local` writes to UPLOAD_DIR and serves files from the API at
# /v1/assets/files/* (development only). `r2` uses Cloudflare R2 (S3 compatible).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Required when STORAGE_DRIVER=r2:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public base URL that stored files are served from (no trailing slash).
PUBLIC_ASSET_BASE_URL=http://localhost:4000/v1/assets/files

# Number of reverse proxies in front of the API (0 locally). Needed so rate limits see the real client IP.
TRUST_PROXY_HOPS=0
