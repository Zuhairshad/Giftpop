# Server-side only. Never prefix with NEXT_PUBLIC_.
# Where the Next.js server proxies /api/* to (becomes ${API_URL}/v1/*).
API_URL=http://localhost:4000

# Where uploaded images are served from (same value as the API). next/image only resizes
# images from this host; read at build time and by `next start`.
PUBLIC_ASSET_BASE_URL=http://localhost:4000/v1/assets/files
