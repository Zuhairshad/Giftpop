{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {},
    "typecheck": {},
    "test": {},
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true, "env": ["API_URL", "NOTIFICATIONS_WORKER"] },
    "verify": { "dependsOn": ["lint", "typecheck", "test"] }
  }
}
