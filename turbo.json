{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {},
    "typecheck": {},
    "test": {},
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "PUBLIC_ASSET_BASE_URL", "WEB_ORIGIN"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_URL",
        "PUBLIC_ASSET_BASE_URL",
        "WEB_ORIGIN",
        "NOTIFICATIONS_WORKER",
        "SENTRY_DSN",
        "SENTRY_TRACES_SAMPLE_RATE"
      ]
    },
    "verify": { "dependsOn": ["lint", "typecheck", "test"] }
  }
}
